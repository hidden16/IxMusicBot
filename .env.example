# Copy this file to .env and fill in the values.
# Копирай този файл като .env и попълни стойностите.

# ── Required / Задължителни ─────────────────────────────────────────────

# Bot token: https://discord.com/developers/applications -> Bot -> Reset Token. Never share it!
# Токенът на бота: https://discord.com/developers/applications -> Bot -> Reset Token. Никога не го споделяй!
DISCORD_TOKEN=

# Your server ID. Enable Developer Mode (User Settings -> Advanced), then right-click the server icon -> Copy Server ID.
# If set, slash commands appear instantly in this server.
# ID на твоя сървър. Включи Developer Mode (User Settings -> Advanced), после десен клик върху иконата на сървъра -> Copy Server ID.
# Ако е попълнено, slash командите се появяват веднага в този сървър.
# Example / Пример: GUILD_ID=987654321098765432
GUILD_ID=

# ── Optional / По желание ───────────────────────────────────────────────

# Music channel: music commands work only in this text channel, and the bot posts its messages there.
# Create the channel yourself, then right-click it -> Copy Channel ID (Developer Mode must be on).
# Empty = commands work in every channel.
# Музикален канал: командите работят само в този текстов канал и ботът пише съобщенията си там.
# Създай канала сам, после десен клик върху него -> Copy Channel ID (нужен е Developer Mode).
# Празно = командите работят във всички канали.
# Example / Пример: MUSIC_CHANNEL_ID=112233445566778899
MUSIC_CHANNEL_ID=

# Only these users can use the bot. Empty = everyone in the server.
# A User ID is a 17-19 digit number, not your username. With Developer Mode on,
# right-click your name (or a friend's) -> Copy User ID. Separate several IDs with commas.
# Само тези потребители могат да ползват бота. Празно = всички в сървъра.
# User ID е число от 17-19 цифри, а не потребителското име. С включен Developer Mode
# десен клик върху своето име (или на приятел) -> Copy User ID. Няколко ID-та се разделят със запетая.
# Example / Пример (one user / един потребител):     ALLOWED_USER_IDS=123456789012345678
# Example / Пример (several / няколко потребители):  ALLOWED_USER_IDS=123456789012345678,234567890123456789
ALLOWED_USER_IDS=

# Bot language: auto = follows each user's Discord language (Bulgarian -> bg, anything else -> en), or force bg / en.
# Език на бота: auto = според езика на Discord на всеки потребител (български -> bg, друг -> en), или задай bg / en.
LANGUAGE=auto

# Path to ffmpeg.exe if it is not in PATH / Път до ffmpeg.exe, ако не е в PATH
# Example / Пример: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Starting volume (0-100) / Начална сила на звука (0-100)
DEFAULT_VOLUME=50

# Seconds without music before the bot leaves the voice channel
# След колко секунди без музика ботът да излезе от гласовия канал
IDLE_TIMEOUT=300

# Maximum number of songs in the queue / Максимален брой песни в опашката
MAX_QUEUE=100

# Automatic yt-dlp updates (works when the bot is started with run.bat).
# Checks for a new version every UPDATE_CHECK_HOURS hours and restarts the bot when no music is playing.
# Автоматично обновяване на yt-dlp (работи, когато ботът е стартиран с run.bat).
# Проверява за нова версия на всеки UPDATE_CHECK_HOURS часа и рестартира бота, когато не свири музика.
AUTO_UPDATE=true
UPDATE_CHECK_HOURS=24
